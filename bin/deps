#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib/common.sh
source "$(dirname "$0")/../lib/common.sh"
[ $# = 1 ] || die "usage: bin/deps <recipe>"
if [ "$(uname)" = Darwin ]; then
  pkgs="$(recipe_get "$1" '.build-deps.brew // [] | join(" ")')"
  # shellcheck disable=SC2086
  [ -z "$pkgs" ] || brew install $pkgs
else
  pkgs="$(recipe_get "$1" '.build-deps.apt // [] | join(" ")')"
  sudo=""; [ "$(id -u)" = 0 ] || sudo=sudo
  # shellcheck disable=SC2086
  [ -z "$pkgs" ] || { $sudo apt-get update -qq && $sudo apt-get install -y --no-install-recommends $pkgs; }
fi

if [ -n "$(recipe_get "$1" .rustup.version)" ] && ! command -v rustup >/dev/null; then
  init="$(mktemp -d)/rustup-init"
  "$ROOT/bin/fetch" "$1" ".rustup.downloads.\"$(host_target)\"" "$init"
  chmod +x "$init"
  "$init" -y --no-modify-path --profile minimal --default-toolchain none
  [ -z "${GITHUB_PATH:-}" ] || echo "$HOME/.cargo/bin" >> "$GITHUB_PATH"
fi
